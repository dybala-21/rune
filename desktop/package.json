{
  "name": "rune-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RUNE desktop shell — a hardened Electron window over the RUNE web UI + daemon.",
  "main": "main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "dev": "RUNE_UI_URL=http://localhost:5173 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.rune.desktop",
    "productName": "RUNE",
    "files": [
      "main.js",
      "preload.js",
      "browser-host.js",
      "browser-shield.js"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "dybala-21",
      "repo": "rune"
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
